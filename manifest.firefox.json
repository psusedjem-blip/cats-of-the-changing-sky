{
  "manifest_version": 3,
  "name": "Cats of the Changing Sky",
  "version": "3.38.0",
  "description": "Four cats climb twelve painted worlds in Classic, Zen, and Expedition modes.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Play Cats of the Changing Sky",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cats-of-the-changing-sky@psusedjem-blip",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
